def evaluate(expression):
    stack = []

    for token in expression.split():

        if token.lstrip('-').isdigit():
            stack.append(int(token))

        else:
            if len(stack) < 2:
                print("Invalid expression: insufficient operands")
                return

            b = stack.pop()
            a = stack.pop()

            if token == '/' and b == 0:
                print("Division by zero")
                return

            if token == '+':
                stack.append(a + b)
            elif token == '-':
                stack.append(a - b)
            elif token == '*':
                stack.append(a * b)
            elif token == '/':
                stack.append(a / b)
            elif token == '^':
                stack.append(a ** b)
            elif token == '%':
                stack.append(a % b)

    if len(stack) != 1:
        print("Invalid expression")
    else:
        print("Result:", stack[0])

evaluate("5 2 ^ 3 %")
evaluate("8 0 /")
evaluate("4 +")
