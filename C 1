class Student {
    // Attributes
    String name;
    int rollNo;

    // Method
    void display() {
        System.out.println("Name: " + name);
        System.out.println("Roll No: " + rollNo);
    }
}

public class Main {
    public static void main(String[] args) {

        // Creating an object
        Student s1 = new Student();

        // Assigning values
        s1.name = "Brindha";
        s1.rollNo = 101;

        // Calling the method
        s1.display();
    }
}



