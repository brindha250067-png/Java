class Student {
    String name;
    int age;

    // Constructor
    Student(String name, int age) {
        this.name = name;
        this.age = age;
    }
}

public class Main {
    public static void main(String[] args) {
        Student s1 = new Student("Alice", 20);

        System.out.println(s1.name); // Alice
        System.out.println(s1.age);  // 20
    }
}
