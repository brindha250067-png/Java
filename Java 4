class Shape {
    void display() {
        System.out.println("This is a shape");
    }
}

class Circle extends Shape {
    void show() {
        System.out.println("This is a circle");
    }
}

public class Main {
    public static void main(String[] args) {
        Circle c = new Circle();

        c.display();  // inherited method
        c.show();
    }
}
